process {
    withLabel:process_single {
        cpus   = { Math.min( 1    * task.attempt, params.max_cpus as int ) }
        memory = { ( 6.GB * task.attempt ).compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1 ? params.max_memory as nextflow.util.MemoryUnit : ( 6.GB * task.attempt ) }
        time   = { ( 12.h * task.attempt ).compareTo(params.max_time as nextflow.util.Duration) == 1 ? params.max_time as nextflow.util.Duration : ( 12.h * task.attempt ) }
    }
    withLabel:process_low {
        cpus   = { Math.min( 2    * task.attempt, params.max_cpus as int ) }
        memory = { ( 12.GB * task.attempt ).compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1 ? params.max_memory as nextflow.util.MemoryUnit : ( 12.GB * task.attempt ) }
        time   = { ( 24.h * task.attempt ).compareTo(params.max_time as nextflow.util.Duration) == 1 ? params.max_time as nextflow.util.Duration : ( 24.h * task.attempt ) }
    }
    withLabel:process_medium {
        cpus   = { Math.min( 4    * task.attempt, params.max_cpus as int ) }
        memory = { ( 32.GB * task.attempt ).compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1 ? params.max_memory as nextflow.util.MemoryUnit : ( 32.GB * task.attempt ) }
        time   = { ( 72.h * task.attempt ).compareTo(params.max_time as nextflow.util.Duration) == 1 ? params.max_time as nextflow.util.Duration : ( 72.h * task.attempt ) }
    }
    withLabel:process_high {
        cpus   = { Math.min( 12   * task.attempt, params.max_cpus as int ) }
        memory = { ( 72.GB * task.attempt ).compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1 ? params.max_memory as nextflow.util.MemoryUnit : ( 72.GB * task.attempt ) }
        time   = { ( 120.h * task.attempt ).compareTo(params.max_time as nextflow.util.Duration) == 1 ? params.max_time as nextflow.util.Duration : ( 120.h * task.attempt ) }
    }
    withLabel:process_long {
        time   = { ( 120.h * task.attempt ).compareTo(params.max_time as nextflow.util.Duration) == 1 ? params.max_time as nextflow.util.Duration : ( 120.h * task.attempt ) }
    }
    withLabel:process_high_memory {
        memory = { ( 200.GB * task.attempt ).compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1 ? params.max_memory as nextflow.util.MemoryUnit : ( 200.GB * task.attempt ) }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: 'process_bismark_align' {
        cpus = 8
        memory = 32.GB
        time = '240h'
        maxForks = 8  // Allow up to 8 concurrent BISMARK_ALIGN processes
    }
    withName: '.*PARABRICKS_FQ2BAMMETH.*' {
        maxForks = 1
    }
    withName: '.*SAMTOOLS_FAIDX.*' {
        maxForks = 1
    }
}


executor {
    name = 'local'
    // These defaults match a large workstation. Override via params.max_cpus/max_memory
    // or by using a custom profile for your environment.
    cpus = params.max_cpus ?: 16
    memory = params.max_memory ?: '128 GB'
    queueSize = 8  // Allow queuing of up to 8 processes
}
