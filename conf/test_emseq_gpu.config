params {
    config_profile_name        = 'Human EM-seq Test profile (GPU)'
    config_profile_description = 'True Human EM-seq dataset (12 samples: asthmatic, atopic, and healthy) from PRJNA1392513 (GPU)'

    // Input data
    sample_sheet = "${projectDir}/data/Sample_sheet_human_emseq.csv"
    genome_fasta = "${projectDir}/data/test_data/Homo_sapiens.GRCh38.dna.primary_assembly.fa"
    gtf_file     = "${projectDir}/data/test_data/Homo_sapiens.GRCh38.104.gtf"
    refseq_file  = "${projectDir}/data/test_data/hg38_RefSeq.bed.gz"

    // GPU Aligner
    aligner = 'bwameth'
    use_parabricks = true
    pre_stage_test_data = true

    // Standardized Benchmarking Parameters
    mode = 'clinical'
    run_clinical_report = true
    skip_diff_meth = false
    diff_meth_method = 'all'
    compare_str = 'all'
    coverage_threshold = 3
    logfc_cutoff = 0.5
    pvalue_cutoff = 0.05
    top_n_genes = 100

    methylkit {
        assembly = 'hg38'
        mc_cores = 8
        diff = 0.25
        qvalue = 0.05
        min_per_group = 1
    }
    dss {
        p_threshold = 0.05
        diff_threshold = 0.1
    }
    edger {
        p_threshold = 0.05
        logfc_cutoff = 0.5
    }

    // Resources (adjust if needed)
    max_cpus   = 16
    max_memory = '220.GB'
    max_time   = '24.h'
}
