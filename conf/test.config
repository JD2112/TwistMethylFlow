params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources 
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input data
    sample_sheet = 'https://raw.githubusercontent.com/nf-core/methylseq/master/assets/samplesheet.csv'
    genome_fasta = 'https://raw.githubusercontent.com/nf-core/test-datasets/methylseq/reference/genome.fa.gz'
    
    // Aligner
    aligner = 'bismark'
}
