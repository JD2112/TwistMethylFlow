/*
========================================================================================
    MILOU Benchmarking Profile
========================================================================================
    This profile is used to standardize benchmarking comparisons between 
    CPU (Bismark) and GPU (Parabricks) execution times. 
    It forces strict resource allocation to ensure fair comparisons.
----------------------------------------------------------------------------------------
*/

params {
    // Restrict maximum resources for fair comparison
    max_memory = '128.GB'
    max_cpus   = 16
    max_time   = '240.h'

    // Save outputs specifically for benchmark analysis
    outdir     = 'results_benchmark'
    
    // Disable differential methylation and reporting to strictly measure alignment/calling
    skip_diff_meth = true
    run_clinical_report = false
}

// Ensure Nextflow captures detailed execution trace and resource usage
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_trace.txt"
    fields  = 'task_id,name,status,exit,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_report.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_timeline.html"
}
