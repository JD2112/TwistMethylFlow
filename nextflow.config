manifest {
    name            = 'milou'
    author          = 'Jyotirmoy Das'
    homePage        = 'https://github.com/JD2112/milou'
    description     = 'milou: Methylation Integrated Layer for Omics Unification'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.2'
    version         = '1.2.0'
    doi             = '10.5281/zenodo.14204260'
}

plugins {
    id 'nf-validation@1.1.3'
}

// Load params.config FIRST so parameters are available to other configs
includeConfig 'conf/params.config'

// Load base.config
includeConfig 'conf/base.config'

// Load resources.config
includeConfig 'conf/resources.config'

// Include container profiles config
includeConfig 'conf/containers.config'

// Profiles config
includeConfig 'conf/profiles.config'


// Export these variables to prevent local Python/R libraries from conflicting with those in the container
env {
    PYTHONNOUSERSITE = 1
    HOME             = "/tmp"
    R_LIBS_USER      = ""
    R_LIBS_SITE      = ""
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    TMPDIR           = System.getenv('TMPDIR') ?: "/tmp"
    TMP              = System.getenv('TMP') ?: "/tmp"
    TEMP             = System.getenv('TEMP') ?: "/tmp"
}

// Retry only on known transient/OOM signals, NOT on general errors (exit 1)
// Exit 143=SIGTERM, 137=OOM-kill, 104=ECONNRESET, 134=SIGABRT, 139=SIGSEGV
process.errorStrategy = { task.exitStatus in [143,137,104,134,139,null] ? 'retry' : 'finish' }
process.maxRetries = 3

// FORCE sequential staging to avoid EBI/SRA connection refused (rate limiting)
// This makes Nextflow behave like single-threaded 'wget'
nextflow.maxParallelTransfers = 1



