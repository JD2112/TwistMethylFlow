manifest {
    name            = 'MethylFlow'
    author          = 'Jyotirmoy Das'
    homePage        = 'https://github.com/JD2112/MethylFlow'
    description     = 'DNA Methylation Data Analysis Pipeline for Twist NGS data'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.2'
    version         = '1.1.0'
    doi             = '10.5281/zenodo.14204261'
}

plugins {
    id 'nf-validation@1.1.3'
}

// Load params.config FIRST so parameters are available to other configs
includeConfig 'conf/params.config'

// Load base.config
includeConfig 'conf/base.config'

// Load resources.config
includeConfig 'conf/resources.config'

// Include container profiles config
includeConfig 'conf/containers.config'

// Profiles config
profiles {
    clinical {
        params.mode = 'clinical'
        params.run_clinical_report = true
    }

    research {
        params.mode = 'research'
        params.run_clinical_report = false
    }

    test_local {
        includeConfig 'conf/test_local.config'
    }

    twist_minimal_gpu {
        includeConfig 'conf/twist_minimal_gpu.config'
    }

    twist_minimal_cpu {
        includeConfig 'conf/twist_minimal_cpu.config'
    }

    twist_full_gpu {
        includeConfig 'conf/twist_full_gpu.config'
    }

    twist_full_cpu {
        includeConfig 'conf/twist_full_cpu.config'
    }

    twist_replicate_article_gpu {
        includeConfig 'conf/twist_replicate_article_gpu.config'
    }

    twist_replicate_article_cpu {
        includeConfig 'conf/twist_replicate_article_cpu.config'
    }

    test_bisulfite {
        includeConfig 'conf/test_bisulfite.config'
    }

    test_emseq {
        includeConfig 'conf/test_emseq.config'
    }

    gpu {
        includeConfig 'conf/gpu.config'
    }
}

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
env {
    PYTHONNOUSERSITE = 1
    HOME             = "/tmp"
    R_LIBS_USER      = ""
    R_LIBS_SITE      = ""
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

// Retry only on known transient/OOM signals, NOT on general errors (exit 1)
// Exit 143=SIGTERM, 137=OOM-kill, 104=ECONNRESET, 134=SIGABRT, 139=SIGSEGV
process.errorStrategy = { task.exitStatus in [143,137,104,134,139,null] ? 'retry' : 'finish' }
process.maxRetries = 3

// FORCE sequential staging to avoid EBI/SRA connection refused (rate limiting)
// This makes Nextflow behave like single-threaded 'wget'
nextflow.maxParallelTransfers = 1



