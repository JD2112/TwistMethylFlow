FROM continuumio/miniconda3:26.1.1

LABEL org.opencontainers.image.authors="Jyotirmoy Das" \
      org.opencontainers.image.description="MethylFlow Unified Results Layer (Python/Conda)" \
      org.opencontainers.image.version="1.1.0"

# Set working directory
WORKDIR /app

# Copy the environment file
COPY unified_environment.yml .

# Create conda environment and clean cache
RUN conda env create -f unified_environment.yml && \
    conda clean -afy

# Upgrade/Install packages in the base environment to resolve vulnerabilities
RUN conda install -n base -c conda-forge \
    urllib3 \
    setuptools \
    wheel \
    cryptography \
    brotli \
    pyjwt \
    -y && \
    conda clean -afy

# Add conda environment to PATH
ENV PATH /opt/conda/envs/methylflow-unified/bin:$PATH

# Install system dependencies and security updates
# NOTE: apt-get upgrade is intentionally kept to patch system-level CVEs
# that cannot be addressed through Conda alone.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    procps \
    build-essential \
    autoconf \
    automake \
    libtool \
    libssl-dev \
    git \
    pkg-config \
    && apt-get clean

# Compile nghttp2 1.68.1 from source to patch CVE-2026-27135
RUN cd /tmp && \
    git clone --depth 1 --branch v1.68.1 https://github.com/nghttp2/nghttp2.git && \
    cd nghttp2 && \
    autoreconf -i && \
    ./configure --prefix=/usr/local --disable-examples --disable-man && \
    make && \
    make install && \
    ldconfig && \
    cd / && \
    rm -rf /tmp/nghttp2

# Clean up build tools
RUN apt-get remove -y build-essential autoconf automake libtool git pkg-config && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Add non-root user and fix permissions
RUN useradd -m -s /bin/bash appuser && \
    chown -R appuser:appuser /app /opt/conda && \
    chmod -R 755 /opt/conda/envs/methylflow-unified/bin

USER appuser

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD conda run -n methylflow-unified python3 --version || exit 1

# Set default command using exec form
CMD ["python3"]
