FROM rocker/r-ver:4.3.3

LABEL org.opencontainers.image.authors="Jyotirmoy Das" \
      org.opencontainers.image.description="Hardened MethylFlow Enrichment (Minimal R)" \
      org.opencontainers.image.version="1.1.0"

# ---- Reproducibility: pin repositories ----
ENV CRAN_REPO=https://packagemanager.posit.co/cran/__linux__/jammy/2024-03-01
ENV BIOC_VERSION=3.18

RUN echo "options(repos = c(CRAN = '${CRAN_REPO}'))" >> /usr/local/lib/R/etc/Rprofile.site && \
    echo "options(BioC_mirror = 'https://packagemanager.posit.co/bioconductor')" >> /usr/local/lib/R/etc/Rprofile.site

# ---- System dependencies ----
# Minimal base requires explicit installation of dependencies for Bioconductor
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    procps \
    libxml2-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    libfontconfig1-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    libicu-dev \
    zlib1g-dev \
    libpq-dev \
    make \
    build-essential \
    autoconf \
    automake \
    libtool \
    git \
    pkg-config \
    && apt-get clean

# Compile nghttp2 1.68.1 from source to patch CVE-2026-27135
RUN cd /tmp && \
    git clone --depth 1 --branch v1.68.1 https://github.com/nghttp2/nghttp2.git && \
    cd nghttp2 && \
    autoreconf -i && \
    ./configure --prefix=/usr/local --disable-examples --disable-man && \
    make && \
    make install && \
    ldconfig && \
    cd / && \
    rm -rf /tmp/nghttp2

# Clean up build tools
RUN apt-get remove -y build-essential autoconf automake libtool git pkg-config && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ---- Install CRAN packages ----
RUN install2.r --error --deps TRUE \
    optparse \
    dplyr \
    ggplot2

# ---- Install Bioconductor packages ----
RUN R -e "\
    options(repos = c(CRAN = Sys.getenv('CRAN_REPO'))); \
    if (!requireNamespace('BiocManager', quietly = TRUE)) install.packages('BiocManager'); \
    BiocManager::install(version = '${BIOC_VERSION}', ask = FALSE); \
    pkgs <- c('clusterProfiler','org.Hs.eg.db','DOSE','ReactomePA','GOplot'); \
    BiocManager::install(pkgs, ask = FALSE, update = FALSE);"

WORKDIR /app
RUN useradd -m -s /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

# Healthcheck
HEALTHCHECK --interval=60s --timeout=15s --start-period=10s --retries=3 \
  CMD R -e "library(clusterProfiler)" || exit 1

CMD ["R"]
