FROM continuumio/miniconda3:26.1.1

LABEL org.opencontainers.image.authors="Jyotirmoy Das" \
      org.opencontainers.image.description="MethylFlow Methylome Profiling (Nextflow/Conda)" \
      org.opencontainers.image.version="1.1.0"

# Set working directory
WORKDIR /app

# Set environment variables for locale and PATH
ENV LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    PATH=/opt/conda/envs/methylflow/bin:$PATH

# Copy the environment file
COPY environment_main.yml environment.yml

# Create conda environment
RUN conda env create -f environment.yml && \
    conda clean -afy

# Upgrade/Install packages in the base environment to resolve vulnerabilities
RUN conda install -n base -c conda-forge \
    urllib3 \
    setuptools \
    wheel \
    cryptography \
    brotli \
    pyjwt \
    -y && \
    conda clean -afy

# Install system dependencies and security updates
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    procps \
    build-essential \
    autoconf \
    automake \
    libtool \
    libssl-dev \
    git \
    pkg-config \
    && apt-get clean

# Compile nghttp2 1.68.1 from source to patch CVE-2026-27135
RUN cd /tmp && \
    git clone --depth 1 --branch v1.68.1 https://github.com/nghttp2/nghttp2.git && \
    cd nghttp2 && \
    autoreconf -i && \
    ./configure --prefix=/usr/local --disable-examples --disable-man && \
    make && \
    make install && \
    ldconfig && \
    cd / && \
    rm -rf /tmp/nghttp2

# Clean up build tools
RUN apt-get remove -y build-essential autoconf automake libtool git pkg-config && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install GOplot using R
RUN R -e "options(repos = c(CRAN = 'https://packagemanager.posit.co/cran/__linux__/jammy/2024-03-01')); if (!requireNamespace('BiocManager', quietly = TRUE)) install.packages('BiocManager'); BiocManager::install('GOplot', ask = FALSE, update = FALSE)"

# Add non-root user and fix permissions
RUN useradd -m -s /bin/bash appuser && \
    chown -R appuser:appuser /app /opt/conda && \
    chmod -R 755 /opt/conda/envs/methylflow/bin

USER appuser

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD conda run -n methylflow fastqc --version || exit 1

# Set default command
CMD ["conda", "run", "--no-capture-output", "-n", "methylflow", "bash"]
