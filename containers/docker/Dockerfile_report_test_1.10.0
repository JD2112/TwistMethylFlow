FROM rocker/r-ver:4.6.0

# Test: Quarto v1.10.0 for Go CVE resolution

LABEL org.opencontainers.image.description="MethylFlow Reporting (R + Quarto) - Test Quarto 1.10.0" \
      org.opencontainers.image.version="1.1.4-test-quarto1.10.0" \
      security.test="quarto_1.10.0_go_cve_resolution"

ENV CRAN_REPO=https://packagemanager.posit.co/cran/__linux__/noble/2026-05-01
RUN echo "options(repos = c(CRAN = '${CRAN_REPO}'))" >> /usr/local/lib/R/etc/Rprofile.site && \
    echo 'options(HTTPUserAgent = sprintf("R/%s R (%s)", getRversion(), paste(getRversion(), R.version["platform"], R.version["arch"], R.version["os"])))' >> /usr/local/lib/R/etc/Rprofile.site

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    procps \
    libxml2-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    libfontconfig1-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    libicu-dev \
    zlib1g-dev \
    libpq-dev \
    wget \
    curl \
    ca-certificates \
    ghostscript \
    libxrender1 \
    make \
    build-essential \
    autoconf \
    automake \
    libtool \
    git \
    pkg-config \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Quarto 1.10.0 (test for Go CVE resolution)
RUN ARCH=$(dpkg --print-architecture) && \
    wget -q https://github.com/quarto-dev/quarto-cli/releases/download/v1.10.0/quarto-1.10.0-linux-${ARCH}.deb && \
    dpkg -i quarto-1.10.0-linux-${ARCH}.deb && \
    rm quarto-1.10.0-linux-${ARCH}.deb

RUN install2.r --error --deps FALSE \
    rlang cli tibble vctrs lifecycle pillar ellipsis fansi stringr

RUN install2.r --error --deps TRUE \
    optparse jsonlite glue dplyr ggplot2 kableExtra knitr rmarkdown

RUN quarto install tinytex

RUN apt-get remove -y build-essential autoconf automake libtool git pkg-config && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN R -e "library(kableExtra); library(dplyr); library(tinytex)" && \
    quarto --version

WORKDIR /app
RUN useradd -m -s /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

HEALTHCHECK --interval=60s --timeout=15s --start-period=20s --retries=3 \
  CMD quarto --version || exit 1

CMD ["quarto", "--version"]
