FROM rocker/r-ver:4.6.0

LABEL org.opencontainers.image.authors="Jyotirmoy Das" \
      org.opencontainers.image.description="Hardened MethylFlow Reporting (Minimal R + Quarto, Go vulnerabilities mitigated)" \
      org.opencontainers.image.version="2.0.0"

ENV CRAN_REPO=https://packagemanager.posit.co/cran/__linux__/noble/2026-05-01

# ---- Configure R repositories ----
RUN echo "options(repos = c(CRAN = '${CRAN_REPO}'))" >> /usr/local/lib/R/etc/Rprofile.site && \
    echo 'options(HTTPUserAgent = sprintf("R/%s R (%s)", getRversion(), paste(getRversion(), R.version["platform"], R.version["arch"], R.version["os"])))' >> /usr/local/lib/R/etc/Rprofile.site

# ---- System dependencies ----
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    libxml2-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    libfontconfig1-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    libicu-dev \
    zlib1g-dev \
    libpq-dev \
    wget \
    curl \
    ca-certificates \
    ghostscript \
    libxrender1 \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ---- Upgrade Quarto to latest (1.6.39) to get newer Go bundled ----
RUN apt-get remove -y quarto || true && \
    ARCH=$(dpkg --print-architecture) && \
    wget -q https://github.com/quarto-dev/quarto-cli/releases/download/v1.6.39/quarto-1.6.39-linux-${ARCH}.deb && \
    dpkg -i quarto-1.6.39-linux-${ARCH}.deb && \
    rm quarto-1.6.39-linux-${ARCH}.deb

# ---- Strip esbuild and rebuild from source with Go 1.25+ ----
# Note: Quarto's esbuild still uses Go 1.20. We compile a patched version.
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    golang-1.25 \
    git \
    && cd /tmp && \
    git clone --depth 1 --branch v0.21.5 https://github.com/evanw/esbuild.git && \
    cd esbuild && \
    /usr/bin/go1.25 build ./cmd/esbuild && \
    ARCH=$(dpkg --print-architecture) && \
    ESBUILD_BINARY=$(find /opt/quarto -name "esbuild" -type f -executable 2>/dev/null | head -1) && \
    if [ -n "$ESBUILD_BINARY" ]; then cp /tmp/esbuild/esbuild "$ESBUILD_BINARY"; chmod +x "$ESBUILD_BINARY"; fi && \
    cd / && \
    rm -rf /tmp/esbuild && \
    apt-get remove -y golang-1.25 git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ---- Install R packages ----
RUN install2.r --error --deps FALSE \
    rlang cli tibble vctrs lifecycle pillar ellipsis fansi stringr

RUN install2.r --error --deps TRUE \
    optparse jsonlite glue dplyr ggplot2 kableExtra knitr rmarkdown

# ---- Install TinyTeX ----
RUN quarto install tinytex

# ---- Smoke test ----
RUN R -e "library(kableExtra); library(dplyr); library(tinytex)" && \
    quarto --version

# ---- Create non-root user ----
WORKDIR /app
RUN useradd -m -s /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

# ---- Health check ----
HEALTHCHECK --interval=60s --timeout=15s --start-period=20s --retries=3 \
  CMD quarto --version || exit 1

CMD ["quarto", "--version"]
