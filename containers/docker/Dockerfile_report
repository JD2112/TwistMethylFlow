FROM rocker/tidyverse:4.5.3

LABEL org.opencontainers.image.authors="Jyotirmoy Das" \
      org.opencontainers.image.description="Hardened milou Reporting (R + Quarto)" \
      org.opencontainers.image.version="1.1.0"

# ---- Reproducibility: pin repositories ----
ENV CRAN_REPO=https://packagemanager.posit.co/cran/__linux__/jammy/2024-03-01
RUN echo "options(repos = c(CRAN = '${CRAN_REPO}'))" >> /usr/local/lib/R/etc/Rprofile.site

# ---- System dependencies ----
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    perl \
    wget \
    curl \
    ca-certificates \
    ghostscript \
    make \
    build-essential \
    autoconf \
    automake \
    libtool \
    git \
    pkg-config \
    libmagick++-dev \
    && apt-get clean

# ---- Install Quarto (Secure Stable Version) ----
RUN ARCH=$(dpkg --print-architecture) && \
    wget https://github.com/quarto-dev/quarto-cli/releases/download/v1.5.57/quarto-1.5.57-linux-${ARCH}.deb && \
    dpkg -i quarto-1.5.57-linux-${ARCH}.deb && \
    rm quarto-1.5.57-linux-${ARCH}.deb

# Compile nghttp2 1.68.1 from source
RUN cd /tmp && \
    git clone --depth 1 --branch v1.68.1 https://github.com/nghttp2/nghttp2.git && \
    cd nghttp2 && \
    autoreconf -i && \
    ./configure --prefix=/usr/local --disable-examples --disable-man && \
    make && \
    make install && \
    ldconfig && \
    cd / && \
    rm -rf /tmp/nghttp2

# ---- Install additional R packages (not in tidyverse base) ----
RUN install2.r --error --deps FALSE \
    getopt \
    optparse \
    jsonlite \
    glue

RUN install2.r --error --deps TRUE \
    kableExtra DT

# ---- Install TinyTeX manually (multi-platform robust) ----
ENV TINYTEX_DIR=/opt/TinyTeX
ENV PATH="/opt/TinyTeX/.TinyTeX/bin/x86_64-linux:/opt/TinyTeX/.TinyTeX/bin/aarch64-linux:${PATH}"
RUN mkdir -p /opt/TinyTeX && \
    wget -qO- "https://yihui.org/tinytex/install-bin-unix.sh" | sh && \
    tlmgr option sys_bin /usr/local/bin && \
    tlmgr path add && \
    tlmgr update --self --all && \
    tlmgr install \
      fancyhdr \
      titling \
      tabu \
      booktabs \
      sectsty \
      tcolorbox \
      pgf \
      environ \
      psnfss \
      tikzfill \
      pdfcol \
      caption \
      fancyvrb \
      fvextra \
      upquote \
      microtype \
      parskip \
      babel \
      setspace \
      infwarerr \
      ltxcmds \
      pdftexcmds \
      kvoptions \
      kvsetkeys \
      auxhook \
      hycolor \
      letltxmacro \
      refcount \
      intcalc \
      gettitlestring \
      kvdefinekeys \
      uniquecounter \
      multirow \
      wrapfig \
      float \
      colortbl \
      pdflscape \
      threeparttable \
      threeparttablex \
      trimspaces \
      ulem \
      makecell \
      etoolbox \
      varwidth \
      geometry \
      hyperref \
      epstopdf-pkg \
      xcolor || true && \
    chmod -R a+rx /opt/TinyTeX

# ---- Final Cleanup of Build Tools ----
RUN apt-get remove -y build-essential autoconf automake libtool git pkg-config && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ---- Smoke test ----
RUN R -e "library(kableExtra); library(dplyr); library(ggplot2); library(knitr); library(rmarkdown)" && \
    quarto --version

WORKDIR /app
RUN useradd -m -s /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

HEALTHCHECK --interval=60s --timeout=15s --start-period=20s --retries=3 \
  CMD quarto --version || exit 1

CMD ["quarto", "--version"]
